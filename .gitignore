# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# next-pwa generated artifacts (regenerados en build)
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map
/public/fallback-*.js

# misc
.DS_Store
*.pem
Thumbs.db

# Python bytecode (los seed scripts en Python lo generan)
__pycache__/
*.pyc
*.pyo
*.pyd

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (NUNCA commitear secretos)
.env
.env*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local
.supabase/
supabase/.branches/
supabase/.temp/

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

.vercel
