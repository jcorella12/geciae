# ------------------------------------------------------------
# ERP Grupo PSENERGIA — variables de entorno
# Copiar a `.env.local` (dev) o configurar en Vercel (staging/prod).
# ------------------------------------------------------------

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # solo server-side / edge functions

# URL pública del sitio — usada para magic links e invitaciones de Supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API (Anthropic) — solo server-side. Setup en docs/sprint-3-ia-setup.md
# Obtener en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# PAC SAT (CFDI 4.0) — SW Sapien o Diverza
PAC_PROVIDER=sw_sapien              # sw_sapien | diverza
PAC_API_URL=
PAC_USER=
PAC_PASSWORD=

# Banxico — TIIE 28 días (token gratuito en https://www.banxico.org.mx/SieAPIRest/)
BANXICO_TOKEN=

# Firma electrónica (Mifiel u otra)
FIRMA_PROVIDER=mifiel
FIRMA_API_KEY=
FIRMA_SECRET=

# Google Vision (OCR económico — opcional para Fase 1)
GOOGLE_VISION_API_KEY=

# Email transaccional (Resend)
RESEND_API_KEY=

# Sentry (errores en prod)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# PostHog (analytics + feature flags — opcional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sprint 8 — Descarga directa SAT
# Clave AES-256-GCM (32 bytes hex) para encriptar contraseñas de FIEL.
# Generar con: openssl rand -hex 32
# Configurar también en Vercel → Settings → Environment Variables.
# IMPORTANTE: si se pierde, las FIELs guardadas no se pueden descifrar.
SAT_FIEL_ENCRYPTION_KEY=

# Secreto opcional para el Vercel Cron de SAT. Vercel lo inyecta como
# `Authorization: Bearer <CRON_SECRET>` en los hits a /api/cron/*.
# Si no se define, el cron solo se valida por el header `x-vercel-cron: 1`
# (que solo Vercel puede inyectar). Generar con: openssl rand -hex 32
CRON_SECRET=
